# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── TTS Provider ─────────────────────────────────────────────────────────────
# Supported: elevenlabs | openai | mock
TTS_PROVIDER=mock

# ElevenLabs (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI TTS + Story (TTS_PROVIDER=openai)
OPENAI_API_KEY=

# ─── Subtitle Timing ──────────────────────────────────────────────────────────
# SKIP_WHISPER_API=true  → instant math-based word timing (FREE, recommended for Railway/Render)
# SKIP_WHISPER_API=false → calls OpenAI Whisper API for perfect sync (costs ~$0.006/min)
SKIP_WHISPER_API=true

# ─── Video Output Resolution ──────────────────────────────────────────────────
# 720x1280  → fast encode, great on phones, ~12s FFmpeg time  ✅ (default, cloud-friendly)
# 1080x1920 → HD encode, slower, ~45s FFmpeg time             (local/premium only)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave blank to use system PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ─── Render Queue ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_RENDERS=1
JOB_TIMEOUT_MS=120000
JOB_MAX_RETRIES=2

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
