# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# NODE_ENV=production is a SECURITY control, not a formality.
#
# Two things key off it: auth.middleware.js refuses to engage the dev-auth bypass
# when it is exactly "production", and tts.service.js refuses the unlicensed Edge
# provider. Both are skipped when NODE_ENV is anything else — INCLUDING when it is
# unset, which is Railway's default. So on a public deployment, if this is left as
# "development" (or deleted) while ALLOW_DEV_AUTH is also set, every anonymous
# request is accepted as the user "dev-user" and the app has no authentication at
# all. Set it to production on every public deploy.
NODE_ENV=development

# ─── Reverse proxies / CORS ────────────────────────────────────────────────────
# TRUST_PROXY_HOPS — how many reverse proxies sit between the browser and this
#   process. Railway: 1. Render: 1. Cloudflare in front of either: 2. Local: 0.
#
#   This is a security setting, not a tuning knob. Express derives req.ip from
#   X-Forwarded-For right-to-left and trusts exactly this many entries. If the real
#   chain is LONGER than this number, the extra entries were chosen by the caller
#   — so anyone can pick their own rate-limit identity by sending
#   X-Forwarded-For, and every rate limiter on the API is defeated. Unset means 0
#   (trust nothing), which is correct for local work.
TRUST_PROXY_HOPS=0

# CORS_ORIGINS — comma-separated browser origins allowed to call this API with
#   credentials. Leave EMPTY when the Express server also serves the frontend
#   (same-origin, the normal Railway setup): no CORS headers are needed then.
#
#   Set it ONLY for a split deployment (static frontend on Vercel, API here), and
#   name that frontend's exact origin. Never "*": the session lives in a cookie,
#   so a wildcard lets any site read signed-in responses out of a logged-in
#   visitor's browser. PUBLIC_BASE_URL is folded in automatically when set.
CORS_ORIGINS=

# ─── Authentication (read carefully) ──────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_BASE64  — REQUIRED. Base64 of your Firebase service
#   account JSON. Without it every authenticated route returns 503.
#   Generate:  node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccountKey.json')).toString('base64'))"
#
# ALLOW_DEV_AUTH — DANGER. When set to "true" the server accepts EVERY request
#   as the user "dev-user" with NO token at all, so every account collapses onto
#   one shared identity and each can read and download the others' videos.
#
#   It only engages when NODE_ENV is not "production", and the server REFUSES TO
#   BOOT if it is set on a recognised host (Railway, Render, Fly, Koyeb, Vercel,
#   or any PUBLIC_BASE_URL starting with http). So enabling it locally is safe;
#   enabling it on a public deployment is a crash, not a silent open door.
#
#   Left EMPTY here on purpose. It used to ship as `true`, so the single most
#   likely mistake — copying this file to a host as the starting .env — quietly
#   turned off authentication for the whole site. Set it yourself for local work.
ALLOW_DEV_AUTH=

# ─── TTS Provider ─────────────────────────────────────────────────────────────
# TTS_PROVIDER: auto (default) | local | openai | edge
#
# auto   — OpenAI if OPENAI_API_KEY is set, otherwise the free offline engine.
#          This is the default and it is what makes a fresh clone and a Railway
#          deploy produce narration with no API key at all.
# local  — Offline speech synthesis only. Free, no API key, no per-character
#          cost, works offline. Windows uses SAPI (System.Speech), Linux uses
#          espeak-ng (already installed by the Dockerfile). Quality is clearly
#          synthetic; if that matters for a paid product set TTS_PROVIDER=openai.
# openai — COMMERCIALLY LICENSED, natural sounding, costs per character.
#          Best choice for paying customers.
# edge   — Microsoft Edge "read aloud" via node-edge-tts. Free, but there is NO
#          licensed commercial contract behind that endpoint: it can be
#          rate-limited, changed or blocked without notice and there is no support
#          path. The server REFUSES this in production unless you also set
#          ALLOW_UNLICENSED_TTS=true, and authPreflight() reports it as a startup
#          error so you cannot ship it by accident.
TTS_PROVIDER=auto

# Only consulted when TTS_PROVIDER=edge. Must be exactly "true".
ALLOW_UNLICENSED_TTS=

# Narration voices. Optional override if tts-1-hd reads better for you.
OPENAI_TTS_MODEL=tts-1
OPENAI_API_KEY=

# NVIDIA story generation (used by the Generate Story button when configured)
NVIDIA_API_KEY=

# Signs completed output video URLs so <video> and download links can work
# without exposing internal paths or requiring an Authorization header.
# REQUIRED in production — the server refuses to boot without it, because a
# missing value would sign every video with a publicly known default string.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTPUT_URL_SECRET=

# ─── Subtitle Timing ──────────────────────────────────────────────────────────
# SKIP_WHISPER_API=true  → instant math-based word timing (FREE, recommended for Railway/Render)
# SKIP_WHISPER_API=false → calls OpenAI Whisper API for perfect sync (costs ~$0.006/min)
SKIP_WHISPER_API=true

# ─── Video Output Resolution ──────────────────────────────────────────────────
# 720x1280  → fast encode, great on phones, ~12s FFmpeg time  ✅ (default, cloud-friendly)
# 1080x1920 → HD encode, slower, ~45s FFmpeg time             (local/premium only)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave blank to use system PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ─── Render Queue ─────────────────────────────────────────────────────────────
# ─── Render Queue ─────────────────────────────────────────────────────────────
# Each render is a TTS call plus a CPU-only libx264 encode of the FULL narration.
# A 3000-character story (the server-side maximum) is roughly 200 seconds of
# audio. The previous value here was 120000 (2 min), which is shorter than a
# long story takes to encode — those jobs timed out, then JOB_MAX_RETRIES ran
# the whole TTS+encode again, so a failing job cost 3x the CPU and still failed.
# Keep this at or above the code default (600000 = 10 min).
MAX_CONCURRENT_RENDERS=1
JOB_TIMEOUT_MS=600000
JOB_MAX_RETRIES=2

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage

# ─── Payments ─────────────────────────────────────────────────────────────────
# Two providers are supported (Stripe and Razorpay) behind one entitlement model,
# so the app's limits never change based on who paid. Both are OFF until fully
# configured: a provider missing either its keys or its price id is treated as
# unavailable, so the pricing page hides that buy button instead of failing at
# checkout.
#
# Every webhook below needs a REAL publicly reachable https URL, or nothing a
# customer buys will ever become Pro. The webhook is what upgrades the account —
# the browser return from checkout only shows them the result.
#
# ── Stripe ───────────────────────────────────────────────────────────────────
# 1. Dashboard → Products → add a recurring monthly product (this is where the
#    amount, currency and tax live — copy it into STRIPE_PRICE_PRO).
# 2. STRIPE_PRICE_PRO = that price id (price_...).
# 3. Dashboard → Billing → Customer portal → Enable, or subscribers cannot
#    cancel and will open support tickets instead.
# 4. Developers → Webhooks → add https://YOURHOST/api/billing/webhook/stripe with
#    events: checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted,
#    invoice.payment_failed. Copy the signing secret to STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Razorpay is included because UPI is how most Indian customers pay and Stripe
# does not offer it. Cards and netbanking come along with it.
# 1. Dashboard → Subscriptions → Plans → create a monthly plan. Copy plan_... .
# 2. Dashboard → Subscriptions → Plan & Activation → turn on "Auto Activation" so
#    Pro starts the moment payment succeeds.
# 3. Dashboard → Settings → Webhooks → add https://YOURHOST/api/billing/webhook/razorpay
#    subscribed to: subscription.activated, subscription.charged,
#    subscription.updated, subscription.halted, subscription.cancelled,
#    subscription.completed. Copy the secret to RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=

# Number of monthly cycles in a Razorpay subscription (12 = a year, renewable).
RAZORPAY_TOTAL_COUNT=12

# ─── Billing shared ──────────────────────────────────────────────────────────
# Absolute URL the customer is returned to after paying. Stripe needs it and
# Razorpay needs a valid origin for the widget. Falls back to
# RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL if unset, but set it explicitly.
PUBLIC_BASE_URL=

# Display currency only. The amount actually charged is whatever the price in the
# provider dashboard says, and the provider enforces it.
DISPLAY_CURRENCY=GBP
