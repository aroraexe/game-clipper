# Agent worktrees / scratch state.
# IMPORTANT: these were previously only listed in .git/info/exclude, which is
# per-clone and never shared through git. A fresh clone had no such rule, so
# `git add .` would have staged .kilo/worktrees/** — which contains a hardcoded
# NVIDIA API key in an old copy of videos.controller.js. Keep this in
# .gitignore (shared) as well as .git/info/exclude (local).
.kilo/
.kilocode/

# Dependencies
node_modules/

# Environment secrets — NEVER commit .env
.env

# Generated video output & temp files
storage/output/
storage/outputs/
storage/temp/

# Gameplay videos (ignore massive originals, allow small versions for Render)
storage/gameplay/*.mp4
storage/gameplay/*.webm
!storage/gameplay/*_small.mp4

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Large test files (ignore at root only, so we don't accidentally ignore allowed files above)
/*.mp4
/*.mp3
tts_test.*
test_*
test-*

storage/jobStore.json

