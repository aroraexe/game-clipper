{
  "version": 2,
  "outputDirectory": "frontend",
  "routes": [
    { "src": "/app",    "dest": "/app.html" },
    { "src": "/signin", "dest": "/signin.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)",   "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
